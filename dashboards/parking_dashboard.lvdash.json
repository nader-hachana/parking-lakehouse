{
  "datasets": [
    {
      "displayName": "pipeline_health",
      "name": "63eec133",
      "queryLines": [
        "WITH yesterday AS (\n",
        "  SELECT\n",
        "    COALESCE(SUM(raw_lines), 0)                  AS lines_ingested,\n",
        "    COALESCE(SUM(rejected_rows), 0)              AS records_dropped,\n",
        "    COALESCE(SUM(rejected_valid_json), 0)        AS corrupt_lines,\n",
        "    COALESCE(SUM(rejected_has_event_id), 0)      AS missing_event_id,\n",
        "    COALESCE(SUM(rejected_known_event_type), 0)  AS unknown_event_type,\n",
        "    COALESCE(SUM(rejected_valid_amount), 0)      AS invalid_amount,\n",
        "    COALESCE(SUM(missing_plate), 0)              AS kept_with_missing_plate\n",
        "  FROM parking.gold.data_quality_by_batch\n",
        "  WHERE DATE(ingested_at) = current_date() - INTERVAL 1 DAY\n",
        "),\n",
        "freshness AS (\n",
        "  SELECT\n",
        "    MAX(_ingested_at) AS last_ingested_at,\n",
        "    ROUND((unix_timestamp(current_timestamp()) - unix_timestamp(MAX(_ingested_at))) / 3600, 1)\n",
        "      AS hours_since_last_ingestion\n",
        "  FROM parking.bronze.raw_events\n",
        ")\n",
        "SELECT\n",
        "  y.*,\n",
        "  f.last_ingested_at,\n",
        "  f.hours_since_last_ingestion,\n",
        "  CASE WHEN f.hours_since_last_ingestion > 26 THEN 'STALE' ELSE 'OK' END AS freshness\n",
        "FROM yesterday y CROSS JOIN freshness f;"
      ]
    },
    {
      "displayName": "freshness",
      "name": "4ee9d7c2",
      "queryLines": [
        "SELECT\n",
        "  MAX(_ingested_at) AS last_ingested_at,\n",
        "  ROUND((unix_timestamp(current_timestamp()) - unix_timestamp(MAX(_ingested_at))) / 3600, 1) AS hours_since_last_ingestion,\n",
        "  CASE WHEN (unix_timestamp(current_timestamp()) - unix_timestamp(MAX(_ingested_at))) / 3600 > 26\n",
        "       THEN 'STALE' ELSE 'OK' END AS freshness\n",
        "FROM parking.bronze.raw_events"
      ]
    },
    {
      "displayName": "last_batch",
      "name": "9702d717",
      "queryLines": [
        "SELECT batch, ingested_at, raw_lines, rejected_rows, reject_share, missing_plate\n",
        "FROM parking.gold.data_quality_by_batch\n",
        "ORDER BY batch DESC\n",
        "LIMIT 1"
      ]
    },
    {
      "displayName": "quality_by_batch",
      "name": "883f122c",
      "queryLines": [
        "SELECT batch, raw_lines, rejected_rows, reject_share,\n",
        "       rejected_valid_json, rejected_has_event_id, rejected_known_event_type, rejected_valid_amount,\n",
        "       missing_plate\n",
        "FROM parking.gold.data_quality_by_batch\n",
        "ORDER BY batch"
      ]
    },
    {
      "displayName": "revenue_daily",
      "name": "eb27b59b",
      "queryLines": [
        "SELECT revenue_date, garage_id, revenue_eur, payments\n",
        "FROM parking.gold.revenue_daily\n",
        "ORDER BY revenue_date, garage_id"
      ]
    },
    {
      "displayName": "parking_duration_daily",
      "name": "2dc785a0",
      "queryLines": [
        "SELECT entry_date, garage_id, avg_duration_minutes, complete_sessions, open_sessions, invalid_sessions\n",
        "FROM parking.gold.parking_duration_daily\n",
        "ORDER BY entry_date, garage_id"
      ]
    },
    {
      "displayName": "zone_occupancy_hourly",
      "name": "cc31cc15",
      "queryLines": [
        "SELECT hour_ts, garage_id, zone_id, cars_present, capacity, occupancy_pct\n",
        "FROM parking.gold.zone_occupancy_hourly\n",
        "ORDER BY hour_ts"
      ]
    },
    {
      "displayName": "sessions_by_status",
      "name": "638d801e",
      "queryLines": [
        "SELECT status, COUNT(*) AS sessions\n",
        "FROM parking.silver.sessions\n",
        "GROUP BY status\n",
        "ORDER BY sessions DESC"
      ]
    }
  ],
